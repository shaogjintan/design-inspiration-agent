# Copy this file to .env.local and fill in your values (.env.local is gitignored).
# app.py also accepts _env.local or .env — it loads the first one it finds.

# Flask — needed before deploying; locally the app warns and uses a dev key
FLASK_SECRET_KEY=a-long-random-string
FLASK_DEBUG=true

# LLM gateway (Ollama-compatible, in front of AWS Bedrock)
# Without these the app still runs, using mock responses.
LLM_GATEWAY_URL=https://your-gateway-url
LLM_GATEWAY_API_KEY=your-gateway-api-key
LLM_MODEL=sonnet4.5:latest
